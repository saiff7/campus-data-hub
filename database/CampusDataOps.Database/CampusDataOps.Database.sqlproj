<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.3.0" />
  <PropertyGroup>
    <Name>CampusDataOps.Database</Name>
    <ProjectGuid>{0F2E7B0C-3B8E-4F7E-A3A1-9D6B5C4E2A10}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
    <TreatTSqlWarningsAsErrors>True</TreatTSqlWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Included into Post-Deployment.sql with :r, not compiled as model objects. -->
    <Build Remove="reference/Seed/**" />
    <None Include="reference/Seed/**" />
    <Build Remove="dq/Seed/**" />
    <None Include="dq/Seed/**" />
    <Build Remove="compliance/Seed/**" />
    <None Include="compliance/Seed/**" />
    <!-- Operational scripts run with sqlcmd after deployment. -->
    <Build Remove="Scripts/**" />
    <None Include="Scripts/**" />
    <Build Remove="Post-Deployment.sql" />
    <PostDeploy Include="Post-Deployment.sql" />
  </ItemGroup>
  <!-- Source simulators live in a separate database. Every cross-database reference uses
       [$(SourceSystems)] and is confined to landing.vw_Source* views, integration.vw_J1*
       views and the outbound adapter, so tests can replace them. -->
  <ItemGroup>
    <ProjectReference Include="../SourceSystems.Database/SourceSystems.Database.sqlproj">
      <DatabaseSqlCmdVariable>SourceSystems</DatabaseSqlCmdVariable>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <SqlCmdVariable Include="SourceSystems">
      <DefaultValue>SourceSystems</DefaultValue>
      <Value>$(SqlCmdVar__1)</Value>
    </SqlCmdVariable>
  </ItemGroup>
</Project>
