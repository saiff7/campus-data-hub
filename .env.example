# Copy to .env and set a strong password. .env is git-ignored; never commit it.
# SQL Server password policy: at least 8 characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=
MSSQL_PORT=1433

# Python pipeline settings (prefix CAMPUS_). Local container uses a self-signed certificate.
CAMPUS_DB_SERVER=localhost,1433
CAMPUS_DB_USER=sa
# CAMPUS_DB_PASSWORD defaults to MSSQL_SA_PASSWORD when unset.
CAMPUS_DB_TRUST_SERVER_CERTIFICATE=true
CAMPUS_SOURCE_DATABASE=SourceSystems
CAMPUS_OPS_DATABASE=CampusDataOps
CAMPUS_SEED=20260901
CAMPUS_SCALE=1.0
CAMPUS_LOG_LEVEL=INFO
